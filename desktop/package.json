{
  "name": "ruhsat360-desktop",
  "version": "1.1.3",
  "description": "Ruhsat360 masaüstü uygulaması (Windows ve macOS)",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac --arm64 --publish never"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.ruhsat360.desktop",
    "productName": "Ruhsat360",
    "directories": {
      "output": "release"
    },
    "afterPack": "./scripts/afterPack.js",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/icon.ico",
      "artifactName": "Ruhsat360-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ruhsat360",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "src/icon.png",
      "category": "public.app-category.productivity",
      "identity": null,
      "artifactName": "Ruhsat360-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "Ruhsat360 ${version}"
    }
  }
}
